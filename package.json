{
  "name": "vtt-tileforge",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@tileforge/web",
    "dev:api": "turbo dev --filter=@tileforge/api",
    "dev:worker": "turbo dev --filter=@tileforge/worker",
    "build": "turbo build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "turbo test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "turbo": "2.10.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  }
}
